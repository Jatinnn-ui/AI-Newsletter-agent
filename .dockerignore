# Shared build context (repo root) for both Dockerfile (backend) and
# Dockerfile.frontend (frontend). Exclude only heavy/secret/irrelevant paths;
# keep source so each image can COPY what it needs.
.git
.github
.venv
backend/.venv
backend/output
backend/data
backend/tests
frontend/node_modules
frontend/dist
scripts/node_modules
docs
**/__pycache__
**/.pytest_cache
**/.env
**/.env.*
**/*.sqlite*
*.pdf
build-fe.log
