# Copy to backend/.env (or the repo root .env) and fill in real values.
# Never commit real keys. Secrets are read only by the backend.

# --- AI (Google Gemini) -----------------------------------------------------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when the main model is rate limited / out of daily quota / overloaded
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash-lite

# --- Web search (Tavily) ----------------------------------------------------
# Get a key: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic

# --- Modes ------------------------------------------------------------------
# true = every run uses labelled fixture data and rule-based writing (no network)
DETERMINISTIC_MODE=false
# allow clients to request a deterministic run per request
ALLOW_DETERMINISTIC_RUNS=true

# --- Access control -----------------------------------------------------------
# Strongly recommended in production. When set, all /api routes except /api/health
# require "Authorization: Bearer <token>" (enter it in the UI under Settings).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# --- Runtime ----------------------------------------------------------------
APP_ENV=development
# Comma-separated list of allowed frontend origins (no wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONCURRENT_RUNS=2
MAX_PENDING_RUNS=8
MAX_RUN_SECONDS=600
REVIEW_PASS_THRESHOLD=80
MAX_REVISIONS=2
APPROVAL_TTL_HOURS=24
RUN_RETENTION_DAYS=7
# Optional storage locations (defaults: backend/output and backend/data)
# OUTPUT_DIR=/var/data/output
# DATA_DIR=/var/data/state

# --- Frontend (frontend/.env.local) -------------------------------------------
# VITE_API_URL=http://127.0.0.1:8000
